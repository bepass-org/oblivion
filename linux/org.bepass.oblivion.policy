<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Oblivion</vendor>
  <vendor_url>https://github.com/bepass-org/oblivion</vendor_url>

  <action id="org.bepass.oblivion.tunnel">
    <description>Turn on tunnel mode</description>
    <description xml:lang="fa">روشن کردن حالت تانل</description>
    <message>Oblivion needs administrator rights to route this computer through the tunnel.</message>
    <message xml:lang="fa">برای هدایت ترافیک این رایانه از داخل تانل، Oblivion به دسترسی مدیر نیاز دارد.</message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/oblivion/oblivion-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
